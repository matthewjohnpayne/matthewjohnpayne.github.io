---
// The publication list is now the "By year" view of /research/. This page sends old links there,
// keeping any co-author filter in the hash (#with=...), which a plain meta refresh would drop.
const target = `${import.meta.env.BASE_URL}research/?view=year`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Publications · Matthew Payne</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.hash);</script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>The publication list has moved to <a href={target}>Research &amp; publications</a>.</p>
  </body>
</html>
