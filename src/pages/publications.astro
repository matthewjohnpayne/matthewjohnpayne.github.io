---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';
import meta from '../data/publications-meta.json';
import collab from '../data/collaborators.json';

const page = pages.find((p) => p.slug === 'publications')!;
const root = import.meta.env.BASE_URL;
// Science notebooks and interactive pages that reproduce a paper, by bibcode.
const exploreMap = new Map<string, { interactive?: string; notebook: string }>();
for (const { data } of await getCollection('tutorials')) for (const b of data.papers) exploreMap.set(b, { interactive: data.interactive && `${root}${data.interactive.replace(/^\//, '')}`, notebook: data.url });
const pubs = (await getCollection('publications'))
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const years = [...new Set(pubs.map((p) => p.year))];
const firstAuthor = pubs.filter((p) => p.authorPosition === 1).length;
// Co-author filter (#with=<ADS normalised name>), used by links from the People page.
const withMap = Object.fromEntries(collab.collaborators.map((c) => [c.key, { name: c.name.split(/,\s*/).reverse().join(' '), bibcodes: c.bibcodes }]));
const fetched = new Date(meta.fetched).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// ADS titles can carry <SUB>, <SUP> and <i> markup; keep only those tags.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const titleHtml = (t: string) => escape(t).replace(/&lt;(\/?)(sub|sup|i)&gt;/gi, (_, slash, tag) => `<${slash}${tag.toLowerCase()}>`);

const isPayne = (a: string) => /^Payne, M(\.|atthew)/.test(a);
// Short author line: up to five names, always including Matthew Payne.
function authorLine(p: (typeof pubs)[number]) {
  const total = p.authorCount ?? p.authors.length;
  const pos = p.authorPosition;
  if (total <= 6) return { shown: p.authors, rest: 0, pos };
  const shown = p.authors.slice(0, 3);
  return { shown, rest: total - 3, pos: pos && pos > 3 ? pos : undefined };
}
const suffix = ['th', 'st', 'nd', 'rd'];
const ordinal = (n: number) => n + (suffix[(n % 100 - 20) % 10] || suffix[n % 100] || 'th');
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width pub-layout">
      <div class="pub-summary">
        <p><strong>{pubs.length}</strong> refereed papers, <strong>{firstAuthor}</strong> as first author, {years.at(-1)}–{years[0]}.</p>
        <fieldset class="pub-filter">
          <legend class="visually-hidden">Show</legend>
          <label><input type="radio" name="pub-filter" value="all" checked /> All papers</label>
          <label><input type="radio" name="pub-filter" value="first" /> First author</label>
        </fieldset>
        <p class="pub-with" id="pub-with" hidden><span id="pub-with-text"></span> <a href="#" id="pub-with-clear">Show all</a></p>
        <p class="pub-source">From <a href={meta.adsUrl} target="_blank" rel="noopener noreferrer">this NASA ADS search ↗</a>, last updated {fetched}. ADS also has citations and full texts.</p>
      </div>

      <div class="pub-list" id="pub-list">
        {years.map((year) => (
          <section class="pub-year" data-year={year}>
            <h2>{year}</h2>
            <ol>
              {pubs.filter((p) => p.year === year).map((p) => {
                const a = authorLine(p);
                return (
                  <li class="pub-item" data-first={p.authorPosition === 1 ? 'true' : 'false'} data-bibcode={p.bibcode}>
                    <a class="pub-title" href={p.url} target="_blank" rel="noopener noreferrer" set:html={titleHtml(p.title)} />
                    <p class="pub-authors">
                      {a.shown.map((name, i) => (
                        <>{i > 0 && ', '}{isPayne(name) ? <strong>{name}</strong> : name}</>
                      ))}
                      {a.rest > 0 && <> and {a.rest} others{a.pos && <> (<strong>Payne</strong> {ordinal(a.pos)})</>}</>}
                    </p>
                    <p class="pub-venue">
                      {p.venue}{p.volume && `, ${p.volume}`}{p.page && `, ${p.page}`}
                      {p.doi && <> · <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer">DOI</a></>}
                    </p>
                    {exploreMap.has(p.bibcode) && (
                    <span class="pub-explore">{exploreMap.get(p.bibcode)!.interactive && <><a href={exploreMap.get(p.bibcode)!.interactive}>Interactive page →</a> · </>}<a href={exploreMap.get(p.bibcode)!.notebook} target="_blank" rel="noopener noreferrer">Notebook ↗</a></span>
                  )}
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </div>
    <div class="content-width">
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>

  <script is:inline type="application/json" id="pub-with-data" set:html={JSON.stringify(withMap)} />
  <script>
    const list = document.getElementById('pub-list')!;
    const withBox = document.getElementById('pub-with')!;
    const withMap: Record<string, { name: string; bibcodes: string[] }> = JSON.parse(document.getElementById('pub-with-data')!.textContent || '{}');
    const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="pub-filter"]')];

    function apply() {
      const firstOnly = radios.find((r) => r.checked)?.value === 'first';
      const key = new URLSearchParams(location.hash.slice(1)).get('with');
      const person = key ? withMap[key] : undefined;
      const allowed = person ? new Set(person.bibcodes) : null;
      list.querySelectorAll<HTMLElement>('.pub-item').forEach((li) => {
        li.hidden = (firstOnly && li.dataset.first !== 'true') || (allowed !== null && !allowed.has(li.dataset.bibcode || ''));
      });
      list.querySelectorAll<HTMLElement>('.pub-year').forEach((sec) => {
        sec.hidden = !sec.querySelector('.pub-item:not([hidden])');
      });
      withBox.hidden = !person;
      if (person) document.getElementById('pub-with-text')!.textContent = `Showing ${person.bibcodes.length} papers with ${person.name}.`;
    }
    radios.forEach((r) => r.addEventListener('change', apply));
    window.addEventListener('hashchange', apply);
    document.getElementById('pub-with-clear')!.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', location.pathname);
      apply();
    });
    apply();
  </script>
</BaseLayout>
