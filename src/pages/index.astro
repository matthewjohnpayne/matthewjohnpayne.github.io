---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeOrbit from '../components/HomeOrbit.astro';
import ScienceVisual from '../components/ScienceVisual.astro';
import ExploreCard from '../components/ExploreCard.astro';
import { featuredPages, explorePages } from '../lib/interactive';
import site from '../data/site.json';
import features from '../data/features.json';
import MpcStats from '../components/MpcStats.astro';
import ObjectTeaser from '../components/ObjectTeaser.astro';
const root = import.meta.env.BASE_URL;
const link = (path: string) => path.startsWith('http') ? path : root + path.replace(/^\//,'');
const featured = await featuredPages(6);
const interactiveCount = (await explorePages()).length;
---
<BaseLayout description={site.introduction}>
  <section class="hero-dark">
    <div class="content-width hero-layout">
      <div class="hero-copy">
        <div class="identity-row">
          <img class="portrait" src={site.portrait ? link(site.portrait) : link('assets/portrait-placeholder.svg')} width="136" height="158" alt="Portrait placeholder; a photograph of Matthew Payne has not yet been provided." />
          <div class="identity-content">
            <p class="eyebrow">{site.eyebrow}</p>
            <p class="hero-name">{site.name}</p>
            <p class="hero-role">Director of the Minor Planet Center</p>
          </div>
        </div>
        <h1>{site.headline}</h1>
        <p class="hero-description">{site.introduction}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={link('research/')}>Explore my research <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={link('explore/')}>Explore & learn <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <HomeOrbit />
    </div>
  </section>
  <section class="site-content home-content">
    <div class="content-width">
      <div class="section-heading">
        <div><p class="section-kicker">SELECTED THEMES</p><h2>Research at a glance</h2></div>
        <a class="text-link" href={link('research/')}>All research <span aria-hidden="true">↗</span></a>
      </div>
      <div class="feature-grid">
        {features.map((feature) => <a class="feature-card" href={link(feature.link)}>
          <div class="feature-illustration"><ScienceVisual kind={feature.visual}/></div>
          <div class="feature-copy"><h3>{feature.title}</h3><p>{feature.description}</p><span class="small-link">{feature.cta} <span aria-hidden="true">→</span></span></div>
        </a>)}
      </div>
      <div class="section-heading home-explore-head">
        <div><p class="section-kicker">INTERACTIVE ESSAYS & SIMULATIONS</p><h2>Explore</h2></div>
        <a class="text-link" href={link('explore/')}>All {interactiveCount} interactive pages <span aria-hidden="true">→</span></a>
      </div>
      <div class="feature-grid home-explore">{featured.map((p) => <ExploreCard page={p} />)}</div>
      <div class="discipline-grid">
        <a href={link('explore/')} class="discipline-item">
          <div class="discipline-number">01</div><div><h3>Explore & learn <span aria-hidden="true">↗</span></h3><p>Interactive explanations, science notebooks, MPC tutorials and teaching.</p></div>
        </a>
        <a href={link('software/')} class="discipline-item">
          <div class="discipline-number">02</div><div><h3>Software <span aria-hidden="true">↗</span></h3><p>Scientific code, tools for orbit analysis and data processing.</p></div>
        </a>
        <a href={link('mpc/')} class="discipline-item">
          <div class="discipline-number">03</div><div><h3>Minor Planet Center <span aria-hidden="true">↗</span></h3><p>Connecting observations to orbital knowledge for the astronomical community.</p></div>
        </a>
      </div>
      <MpcStats moreLink={link('mpc/')} />
      <div class="home-mpc-extra">
        <ObjectTeaser />
        <a class="home-today-link" href={link('mpc/#today')}>
          <p class="section-kicker">LIVE FROM THE MPC</p>
          <h3>Today at the Minor Planet Center</h3>
          <p>The newest circulars announcing discoveries and orbits, and the objects waiting on the NEO Confirmation Page for follow-up.</p>
          <span class="small-link">See today’s activity <span aria-hidden="true">→</span></span>
        </a>
      </div>
      <section class="about-band" aria-label="About Matthew Payne">
        <div>
          <p class="section-kicker">ABOUT</p>
          <h2>Science, software, and the people behind the work.</h2>
          <p>My work combines research in orbital dynamics with scientific computing, community infrastructure and the mentorship of younger scientists.</p>
        </div>
        <div class="about-links"><a class="text-link" href={link('about/')}>About me →</a><a class="text-link" href={link('people/')}>People & collaborators ↗</a><a class="text-link" href={link('research/?view=year')}>Publications ↗</a><a class="text-link" href={site.cfaProfile} target="_blank" rel="noopener noreferrer">CfA biography ↗</a></div>
      </section>
    </div>
  </section>
</BaseLayout>
<style>
  .home-explore-head { margin-top: 66px; }
  .home-explore { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1080px) { .home-explore { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 575px) { .home-explore { grid-template-columns: 1fr; } .home-explore-head { margin-top: 44px; } }
  .home-mpc-extra { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 18px; margin-top: 18px; }
  .home-today-link { display: block; background: #fff; border: 1px solid var(--line); border-radius: 7px; padding: 22px 24px; color: inherit; text-decoration: none; }
  .home-today-link:hover, .home-today-link:focus-visible { border-color: var(--teal); }
  .home-today-link h3 { margin: 4px 0 8px; font-size: 19px; color: var(--ink); }
  .home-today-link p:not(.section-kicker) { margin: 0 0 10px; font-size: 14px; line-height: 1.6; color: var(--body); }
  @media (max-width: 820px) { .home-mpc-extra { grid-template-columns: 1fr; } }
</style>
