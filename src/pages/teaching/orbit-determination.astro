---
import BaseLayout from '../../layouts/BaseLayout.astro';

const root = import.meta.env.BASE_URL;
const ads = (bib: string) => `https://ui.adsabs.harvard.edu/abs/${encodeURIComponent(bib)}/abstract`;
const iod = 'https://docs.minorplanetcenter.net/tutorials/iod_tutorials/';
const digest2 = 'https://docs.minorplanetcenter.net/tutorials/notebooks/mpc_tutorial_digest2/';
const obsApi = 'https://docs.minorplanetcenter.net/tutorials/notebooks/mpc_tutorial_api_observations/';
const references = [
  ['Bowell, E., Hapke, B., Domingue, D., et al. (1989), in Asteroids II, 524', '1989aste.conf..524B'],
  ['Carpino, M., Milani, A. & Chesley, S. R. (2003), Icarus 166, 248', '2003Icar..166..248C'],
  ['Keys, S., Vereš, P., Payne, M. J., et al. (2019), PASP 131, 064501', '2019PASP..131f4501K'],
  ['Milani, A., Gronchi, G. F., de’ Michieli Vitturi, M. & Knežević, Z. (2004), Celest. Mech. Dyn. Astron. 90, 57', '2004CeMDA..90...57M'],
  ['Tonry, J. L., Denneau, L., Heinze, A. N., et al. (2018), PASP 130, 064505', '2018PASP..130f4505T'],
  ['Vereš, P., Farnocchia, D., Chesley, S. R. & Chamberlin, A. B. (2017), Icarus 296, 139', '2017Icar..296..139V']
];
---
<BaseLayout title="How do you find an orbit?" description="An interactive essay on orbit determination: from one night of observations of the asteroid 2024 YR4 to its orbit, using its real astrometry, computed in your browser.">
  <section class="inner-hero rf-hero">
    <div class="content-width inner-hero-content">
      <p class="eyebrow">INTERACTIVE ESSAY · ORBIT DETERMINATION</p>
      <h1>How do you find an orbit?</h1>
      <p>On 2024 December 27 the ATLAS telescope at Rio Hurtado, Chile, recorded a faint dot moving across the sky. Within six weeks, 56 observatories had measured its position 409 times, and the near-Earth asteroid 2024 YR4 had an orbit. This page follows the path from the first night to that orbit, with the real observations, and every calculation runs in your browser.</p>
      <p class="od-status" id="od-load-status" role="status">Loading the observations…</p>
    </div>
  </section>

  <section class="site-content ro-lab" id="od-direction">
    <div class="content-width">
      <div class="ro-head">
        <p class="ro-step">1</p>
        <div><h2>An observation is a direction</h2><p>Where is the asteroid? Somewhere along a line.</p></div>
      </div>
      <div class="od-split">
        <figure class="od-fig">
          <div class="ro-stage od-stage-sq"><canvas id="od-los" role="img" aria-label="Top-down view of the line of sight from the Earth towards 2024 YR4 at discovery"></canvas></div>
          <figcaption>The direction ATLAS measured (dashed), seen from above the plane of the Earth’s orbit. The orange dot is your guess of how far along it the asteroid is.</figcaption>
        </figure>
        <div>
          <fieldset class="ro-segmented od-view">
            <legend>View</legend>
            <label><input type="radio" name="od-los-view" value="near" checked /><span>Near the Earth</span></label>
            <label><input type="radio" name="od-los-view" value="inner" /><span>Inner Solar System</span></label>
          </fieldset>
          <div class="ro-control od-control">
            <label for="od-dist">Guessed distance: <output id="od-dist-out" class="hl-value"></output></label>
            <input id="od-dist" type="range" min="-3" max="0.3" step="0.01" value="-1.4" />
          </div>
          <dl class="rf-readout od-readout-2">
            <div><dt>The discovery tracklet</dt><dd id="od-disc-summary" class="hl-small">–</dd></div>
            <div><dt>Motion across the sky</dt><dd id="od-r-rate">–</dd></div>
            <div><dt>That distance is</dt><dd id="od-r-km">–</dd></div>
            <div><dt>To look as bright as it did, it would be about</dt><dd id="od-r-size">–</dd></div>
          </dl>
          <div class="rf-explain">
            <p><b>What a telescope measures.</b> Each observation is a time, a place on the Earth, and a direction on the sky: right ascension and declination, two angles. It says nothing about distance. ATLAS took four images of the same patch of sky in under an hour; a dot that moved from image to image is a <i>tracklet</i>.</p>
            <p><b>Brightness doesn’t settle it.</b> A small rock close by and a large asteroid far away can look equally bright. The size range shown is for surfaces reflecting between 5% and 25% of sunlight, and is only rough.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-content ro-lab ro-lab-map" id="od-region-section">
    <div class="content-width">
      <div class="ro-head">
        <p class="ro-step">2</p>
        <div><h2>One night allows a whole family of orbits</h2><p>The tracklet gives a direction and how fast it is changing. Guess the rest.</p></div>
      </div>
      <div class="od-split">
        <figure class="od-fig">
          <div class="ro-stage od-stage-region"><canvas id="od-region" tabindex="0" role="img" aria-label="The admissible region for the discovery tracklet"></canvas></div>
          <figcaption>Every coloured point is an orbit that matches the discovery night and is bound to the Sun. Select a point, or focus the chart and use the arrow keys (Shift for bigger steps).</figcaption>
          <ul class="ro-key">
            <li><span class="ro-swatch od-sw-neo"></span>Near-Earth (perihelion under 1.3 au)</li>
            <li><span class="ro-swatch od-sw-inner"></span>Inside Jupiter’s orbit</li>
            <li><span class="ro-swatch od-sw-outer"></span>Beyond Jupiter</li>
            <li><span class="ro-swatch od-sw-earth"></span>Orbiting the Earth</li>
          </ul>
        </figure>
        <figure class="od-fig">
          <div class="ro-stage od-stage-sq"><canvas id="od-orbit" role="img" aria-label="The orbit implied by your guess"></canvas></div>
          <figcaption>The orbit your guess implies (orange), with the orbits of the Earth, Mars and Jupiter.</figcaption>
        </figure>
      </div>
      <div class="hl-controls">
        <div class="ro-control">
          <label for="od-dist2">Guessed distance: <output id="od-dist2-out" class="hl-value"></output></label>
          <input id="od-dist2" type="range" min="-3" max="0.3" step="0.01" value="-1.4" />
        </div>
        <div class="ro-control">
          <label for="od-rhod">Guessed speed away from us: <output id="od-rhod-out" class="hl-value"></output></label>
          <input id="od-rhod" type="range" min="-60" max="60" step="0.1" value="0" />
        </div>
        <dl class="rf-readout od-readout-5">
          <div><dt>Kind of orbit</dt><dd id="od-r-class" class="hl-small">–</dd></div>
          <div><dt>Semi-major axis a</dt><dd id="od-r-a">–</dd></div>
          <div><dt>Eccentricity e</dt><dd id="od-r-e">–</dd></div>
          <div><dt>Inclination i</dt><dd id="od-r-i">–</dd></div>
          <div><dt>Perihelion q</dt><dd id="od-r-q">–</dd></div>
        </dl>
        <div class="od-reveal-row">
          <button type="button" class="rf-button" id="od-reveal" aria-pressed="false">Show JPL’s answer</button>
          <p id="od-reveal-text" class="od-reveal-text" role="status"></p>
        </div>
      </div>
      <div class="rf-explain hl-explain">
        <p><b>Four numbers out of six.</b> An orbit needs six numbers: a position and a velocity in three dimensions. A tracklet gives four: two angles and how fast each is changing. The distance and the speed along the line of sight are missing. Every pair of guesses gives a complete orbit; the pairs that give an orbit bound to the Sun make up the <i>admissible region</i> (<a href={ads('2004CeMDA..90...57M')} target="_blank" rel="noopener noreferrer">Milani et al. 2004</a>).</p>
        <p><b>Fast means near.</b> 2024 YR4 crossed the sky at 9° a day. Far away, that would need a speed no orbit around the Sun can have, so beyond <span id="od-maxrho">–</span> every guess gives an orbit that escapes the Solar System. A slow-moving dot leaves a much bigger region.</p>
        <p><b>How the MPC uses this.</b> The MPC’s digest2 code scores each new tracklet by searching distances from 0.05 to 100 au and the possible motions at each, and asking what fraction of the orbits found are near-Earth (<a href={ads('2019PASP..131f4501K')} target="_blank" rel="noopener noreferrer">Keys et al. 2019</a>). Tracklets with high scores go on the NEO Confirmation Page for follow-up. The <a href={digest2} target="_blank" rel="noopener noreferrer">digest2 tutorial</a> shows how to run it.</p>
      </div>
    </div>
  </section>

  <section class="site-content ro-lab ro-lab-map" id="od-next">
    <div class="content-width">
      <div class="ro-head">
        <p class="ro-step">3</p>
        <div><h2>Where will it be tomorrow?</h2><p>Follow every orbit in the family forward, and compare with what telescopes saw.</p></div>
      </div>
      <div class="ro-compute">
        <label>Predict for
          <select id="od-target"></select>
        </label>
        <label>View
          <select id="od-banana-zoom">
            <option value="0.25">±0.25°</option>
            <option value="1">±1°</option>
            <option value="5" selected>±5°</option>
            <option value="25">±25°</option>
          </select>
        </label>
        <button type="button" class="rf-button" id="od-banana-run">Predict</button>
        <p class="ro-progress" id="od-banana-status" role="status"></p>
      </div>
      <figure class="od-fig od-wide">
        <div class="ro-stage od-stage-wide"><canvas id="od-banana" role="img" aria-label="Predicted positions on a later night"></canvas></div>
        <figcaption>Each dot is where one orbit from the family puts 2024 YR4, coloured by its guessed distance: <span class="od-grad"></span> <span id="od-fam-range">near (purple) to far (yellow)</span>. The red cross is where it was actually observed; the orange circle is your guess from section 2.</figcaption>
      </figure>
      <p class="ro-hover" id="od-banana-key" aria-live="polite"></p>
      <div class="rf-explain hl-explain">
        <p><b>The banana.</b> The predictions stretch into a long curved band, sometimes many degrees long, and the band grows every night. Nearby orbits spread out fastest. This is why a new near-Earth object needs follow-up within a day or two: wait too long and nobody knows where to point a telescope.</p>
        <p><b>Try it.</b> Move your guess in section 2 and watch the orange circle slide along the band. Only orbits near JPL’s answer pass close to the red cross.</p>
      </div>
    </div>
  </section>

  <section class="site-content ro-lab ro-lab-map" id="od-gauss">
    <div class="content-width">
      <div class="ro-head">
        <p class="ro-step">4</p>
        <div><h2>Three nights: Gauss’s method</h2><p>Three directions at three times are enough to pin down an orbit.</p></div>
      </div>
      <div class="ro-presets od-presets" id="od-gauss-presets" role="group" aria-label="Choices of three nights"></div>
      <div class="ro-compute od-gauss-pick">
        <label>First<select id="od-g1"></select></label>
        <label>Second<select id="od-g2"></select></label>
        <label>Third<select id="od-g3"></select></label>
        <button type="button" class="rf-button" id="od-gauss-run">Solve</button>
      </div>
      <p class="ro-progress od-gauss-status" id="od-gauss-status" role="status"></p>
      <div class="ro-presets od-roots" id="od-gauss-roots" role="group" aria-label="Solutions"></div>
      <div class="od-split">
        <figure class="od-fig">
          <div class="ro-stage od-stage-sq"><canvas id="od-gauss-orbit" role="img" aria-label="The orbit from Gauss's method"></canvas></div>
          <figcaption>Gauss’s orbit (orange) and JPL’s (dashed teal).</figcaption>
        </figure>
        <figure class="od-fig">
          <div class="ro-stage od-stage-sq"><canvas id="od-gauss-res" role="img" aria-label="Miss distances of all the observations from Gauss's orbit"></canvas></div>
          <figcaption>How far Gauss’s orbit, following the Sun’s gravity alone, misses each of the 409 observations over the six weeks (log scale). Circles mark the three it was built from; the dashed line is half an arcsecond, about the accuracy of a good observation.</figcaption>
        </figure>
      </div>
      <dl class="rf-readout od-readout-4">
        <div><dt>Semi-major axis a</dt><dd id="od-g-a" class="hl-small">–</dd></div>
        <div><dt>Eccentricity e</dt><dd id="od-g-e" class="hl-small">–</dd></div>
        <div><dt>Inclination i</dt><dd id="od-g-i" class="hl-small">–</dd></div>
        <div><dt>Median miss, all observations</dt><dd id="od-g-rms">–</dd></div>
      </dl>
      <div class="rf-explain hl-explain">
        <p><b>The method.</b> Carl Friedrich Gauss devised it in 1801 to predict where Ceres, found that January and then lost in the Sun’s glare, would reappear; it was found again close to his prediction. Requiring the three positions to lie in one plane, on one Keplerian orbit, leads to an eighth-degree polynomial for the asteroid’s distance from the Sun at the middle time; each positive root is a possible orbit. The orbit is then refined until it passes exactly through the three observations.</p>
        <p><b>Try it.</b> The orbit passes through its three observations, and misses the others. Three observations from one night give a rough orbit that misses later observations by about a minute of arc; spreading them over days or weeks does much better. But Gauss’s orbit follows the Sun’s gravity alone, and 2024 YR4 was still close to the Earth, whose pull bends its path; no choice of three observations makes up for that. The least squares in section 5 include the planets and the Moon.</p>
      </div>
    </div>
  </section>

  <section class="site-content ro-lab ro-lab-map" id="od-many">
    <div class="content-width">
      <div class="ro-head">
        <p class="ro-step">5</p>
        <div><h2>Many nights: least squares</h2><p>Use every observation, weigh each by its accuracy, and find the orbit that fits them all best.</p></div>
      </div>
      <div class="ro-compute">
        <div class="ro-control od-arc">
          <label for="od-arc">Observations used: <output id="od-arc-out" class="hl-small od-arc-out"></output></label>
          <input id="od-arc" type="range" min="0" max="9" step="1" value="2" />
        </div>
        <button type="button" class="rf-button" id="od-fit-all">Fit every arc length</button>
        <p class="ro-progress" id="od-fit-status" role="status"></p>
      </div>
      <dl class="rf-readout od-readout-7">
        <div><dt>Observations used</dt><dd id="od-f-used">–</dd></div>
        <div><dt>RMS residual</dt><dd id="od-f-rms">–</dd></div>
        <div><dt>a</dt><dd id="od-f-a" class="hl-small">–</dd></div>
        <div><dt>e</dt><dd id="od-f-e" class="hl-small">–</dd></div>
        <div><dt>i</dt><dd id="od-f-i" class="hl-small">–</dd></div>
        <div><dt>q</dt><dd id="od-f-q" class="hl-small">–</dd></div>
        <div><dt>Uncertainty on 2025 May 1 (1σ)</dt><dd id="od-f-unc">–</dd></div>
      </dl>
      <div class="od-triple">
        <figure class="od-fig">
          <div class="ro-stage od-stage-chart"><canvas id="od-fit-res" role="img" aria-label="Residuals of the fit"></canvas></div>
          <figcaption>Residuals: observed minus computed, in <span class="od-k-ra">right ascension</span> and <span class="od-k-dec">declination</span>. Open circles are observations rejected as outliers.</figcaption>
        </figure>
        <figure class="od-fig">
          <div class="ro-stage od-stage-chart"><canvas id="od-cloud" role="img" aria-label="Spread of predicted positions on 2025 May 1"></canvas></div>
          <figcaption>Where 300 orbits allowed by the fit put the asteroid on 2025 May 1, nearly three months after the last observation on this page, as seen from the centre of the Earth. The teal cross is the position from JPL’s orbit, which uses many more observations.</figcaption>
        </figure>
        <figure class="od-fig">
          <div class="ro-stage od-stage-chart"><canvas id="od-trend" role="img" aria-label="Uncertainty against the number of days of observations"></canvas></div>
          <figcaption>The uncertainty on 2025 May 1 for each arc length you have fitted.</figcaption>
        </figure>
      </div>
      <div class="rf-explain hl-explain">
        <p><b>Differential correction.</b> Start from a preliminary orbit (here, Gauss’s method on the first, middle and last nights), predict every observation, and adjust the six numbers of the orbit to make the weighted sum of squared misses as small as possible. Repeat until nothing changes. Observations that miss by far more than their uncertainty are set aside as outliers, and taken back if a later orbit fits them.</p>
        <p><b>What the uncertainty means.</b> The fit also says how far the orbit could move and still match the observations. More nights, and a longer span of time, shrink that range: with two days of data the position on May 1 is uncertain by nearly 20″, and with six weeks by about 2″. This asteroid was unusually well placed: it was so close to the Earth that observatories in different places saw it in measurably different directions, which pins down its distance quickly. For objects further away, short arcs leave far larger uncertainties.</p>
      </div>
    </div>
  </section>

  <section class="site-content rf-prose">
    <div class="content-width rf-prose-inner">
      <h2>What happened next</h2>
      <p>In early 2025, before enough observations had been collected, an impact with the Earth in 2032 could not be ruled out, and the asteroid drew worldwide attention. More observations, including the ones on this page and many later ones, have since ruled that out. Its story is a vivid example of the process above: the uncertainty in an orbit shrinks as observations accumulate, and what looks possible early on may later be excluded.</p>

      <h2>How this page works</h2>
      <ul>
        <li><b>The observations</b> are every optical observation of 2024 YR4 from 2024 December 25 to 2025 February 8 in the MPC’s database, from the <a href={obsApi} target="_blank" rel="noopener noreferrer">MPC Observations API</a>. A few, made before December 27, were found later in archived images. The position of each observatory at each moment comes from JPL Horizons. The site’s <code>tools/export_od_data.py</code> collects them.</li>
        <li><b>Gravity.</b> Orbits are integrated with the Sun, the eight planets and the Moon, at positions from JPL Horizons, using a fourth-order Runge–Kutta method with a step of 1/64 day (1/32 day for the family of predictions and 1/16 day for the uncertainty clouds). Each predicted position allows for the time light takes to travel from the asteroid to the telescope.</li>
        <li><b>Gauss’s method</b> follows the textbook algorithm, with the orbit refined by universal-variable Lagrange coefficients and corrected for light time. It, and the misses shown with it, use the Sun’s gravity alone.</li>
        <li><b>Least squares.</b> Gauss–Newton iteration with numerical derivatives. Each observation is weighted by its reported uncertainty, but never as better than 0.5″: errors are often shared by observations made close together in time, so treating every observation as independent overstates the accuracy (<a href={ads('2003Icar..166..248C')} target="_blank" rel="noopener noreferrer">Carpino et al. 2003</a>; <a href={ads('2017Icar..296..139V')} target="_blank" rel="noopener noreferrer">Vereš et al. 2017</a>). Outliers are handled in the spirit of Carpino et al. (2003): an observation is set aside when its χ² exceeds 8 and restored when it falls below 7. Uncertainties come from the fit’s covariance, sampled with 300 orbits.</li>
        <li><b>Validation</b> (<code>tools/validate_od/</code>). Started from JPL’s orbit, this page’s force model reproduces JPL Horizons’ positions of 2024 YR4 for all 409 observations to better than 0.03″, and its position on 2025 May 1 to 8 km (the page leaves out relativity and the gravity of the largest asteroids). An independent SciPy implementation agrees with the page: to 0.003″ for the family of predictions, to less than a millimetre for Gauss’s method, and to within 0.1σ for least-squares orbits from one week to six weeks of data. The orbit from all six weeks lies about 150 km from JPL’s orbit, about 2σ, as expected for six fitted numbers.</li>
        <li><b>Limitations.</b> This is an educational adaptation, not the MPC’s orbit software. Production orbit determination adds much more: observatory-by-observatory weights and corrections, more perturbing bodies, and careful checks of which observations belong to which object. The rough sizes in section 1 use the IAU H, G magnitude system (<a href={ads('1989aste.conf..524B')} target="_blank" rel="noopener noreferrer">Bowell et al. 1989</a>) with the reported magnitudes as they stand.</li>
      </ul>

      <h2>References</h2>
      <ul class="ro-refs">
        {references.map(([text, bib]) => <li>{text}. <a href={ads(bib)} target="_blank" rel="noopener noreferrer">ADS</a></li>)}
        <li>Curtis, H. D., Orbital Mechanics for Engineering Students (Butterworth-Heinemann), Chapter 5: Gauss’s method of preliminary orbit determination.</li>
        <li>Minor Planet Center, Initial Orbit Determination tutorials. <a href={iod} target="_blank" rel="noopener noreferrer">docs.minorplanetcenter.net</a></li>
        <li>JPL Horizons. <a href="https://ssd.jpl.nasa.gov/horizons/" target="_blank" rel="noopener noreferrer">ssd.jpl.nasa.gov</a></li>
      </ul>
      <div class="rf-links">
        <a class="text-link" href={iod} target="_blank" rel="noopener noreferrer">MPC orbit-determination tutorials ↗</a>
        <a class="text-link" href={`${root}teaching/`}>All tutorials →</a>
      </div>
    </div>
  </section>

  <style is:global>
    .od-status{font-size:14px;color:#cfe3e6;margin-top:10px}
    .od-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px;align-items:start}
    .od-triple{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:18px}
    .od-fig{margin:0}.od-fig figcaption{font-size:12px;line-height:1.55;color:var(--body);margin-top:8px}
    .od-wide{margin-top:16px}
    .od-stage-sq{aspect-ratio:1/1}.od-stage-region{aspect-ratio:5/4}.od-stage-wide{aspect-ratio:2/1;min-height:260px}.od-stage-chart{aspect-ratio:4/3;min-height:220px}
    .od-view{margin-bottom:18px}.od-control{margin-bottom:6px}.od-readout-2+.rf-explain{margin-top:18px}
    .od-readout-2{grid-template-columns:repeat(2,minmax(0,1fr))}.od-readout-4{grid-template-columns:repeat(4,minmax(0,1fr))}
    .od-readout-5{grid-template-columns:repeat(5,minmax(0,1fr))}.od-readout-7{grid-template-columns:repeat(7,minmax(0,1fr))}
    .od-sw-neo{background:rgba(217,130,43,.55)}.od-sw-inner{background:rgba(7,141,151,.5)}.od-sw-outer{background:rgba(63,111,143,.5)}.od-sw-earth{background:rgba(154,111,176,.55)}
    .od-reveal-row{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;margin-top:14px}
    .od-reveal-text{margin:0;font-size:14px;color:var(--ink);flex:1 1 320px;line-height:1.55}
    .od-grad{display:inline-block;width:60px;height:9px;border-radius:2px;vertical-align:middle;background:linear-gradient(90deg,#440154,#3b528b,#21918c,#5ec962,#fde725)}
    .od-presets{margin-bottom:6px}#od-target{max-width:100%}.ro-compute>label{max-width:100%}.od-gauss-pick select{max-width:min(330px,100%)}.od-gauss-status{margin:10px 0 6px}.od-roots{margin-bottom:14px}
    .od-roots .ro-chip[aria-pressed="true"]{background:var(--teal);border-color:var(--teal);color:#fff}
    .od-arc{flex:1 1 360px}.od-arc-out{display:block;margin-top:4px;color:var(--ink)}
    .od-k-ra{color:#06717a;font-weight:650}.od-k-dec{color:#94590a;font-weight:650}
    @media(max-width:1080px){.od-readout-7{grid-template-columns:repeat(4,minmax(0,1fr))}.od-triple{grid-template-columns:1fr 1fr}}
    @media(max-width:820px){.od-split,.od-triple{grid-template-columns:1fr}.od-readout-5{grid-template-columns:repeat(3,minmax(0,1fr))}.od-readout-4{grid-template-columns:1fr 1fr}.od-stage-wide{aspect-ratio:4/3}}
    @media(max-width:575px){.od-readout-7,.od-readout-5{grid-template-columns:1fr 1fr}.od-readout-2{grid-template-columns:1fr}}
  </style>

  <script>
    import { startOD } from '../../scripts/od/app.js';
    startOD(import.meta.env.BASE_URL);
  </script>
</BaseLayout>
