---
import BaseLayout from '../layouts/BaseLayout.astro';
// Hidden page: not linked from the navigation and not indexed. How players find it is
// still to be decided (see docs/ROADMAP.md).
---
<BaseLayout title="Kepleroids" description="A small game in which everything orbits the Sun." noindex>
  <section class="site-content bl-page">
    <div class="content-width">
      <div id="kepleroids"></div>
      <p class="bl-note">Everything in the game moves under the Sun’s inverse-square gravity, integrated with a leapfrog scheme; the dotted line is your ship’s path if you stop thrusting.</p>
    </div>
  </section>
  <script>
    import { startKepleroids } from '../scripts/kepleroids/game.js';
    startKepleroids(document.getElementById('kepleroids'));
  </script>
</BaseLayout>
