---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';
import research from '../data/research.json';

const page = pages.find((p) => p.slug === 'research')!;
const root = import.meta.env.BASE_URL;
// Science notebooks and interactive pages that reproduce a paper, by bibcode.
const exploreMap = new Map<string, { interactive?: string; notebook: string }>();
for (const { data } of await getCollection('tutorials')) for (const b of data.papers) exploreMap.set(b, { interactive: data.interactive && `${root}${data.interactive.replace(/^\//, '')}`, notebook: data.url });
const pubs = new Map((await getCollection('publications')).map((p) => [p.data.bibcode, p.data]));

// Every paper belongs to one theme (or "other"); say so at build time if not.
const assigned = new Set([...research.themes.flatMap((t) => t.bibcodes), ...research.other.bibcodes]);
const unassigned = [...pubs.keys()].filter((b) => b && !assigned.has(b));
if (unassigned.length) console.warn(`[research] Papers not in any theme in src/data/research.json: ${unassigned.join(', ')}`);
const missing = [...assigned].filter((b) => !pubs.has(b));
if (missing.length) console.warn(`[research] Bibcodes in research.json with no publication record: ${missing.join(', ')}`);

const papersFor = (bibcodes: string[]) => bibcodes
  .map((b) => pubs.get(b))
  .filter((p) => p !== undefined)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
type Link = { label: string; href: string; group?: string };
// Consecutive links that share a group (a topic, usually an interactive page and its notebook)
// are shown together under the group's name.
const groupLinks = (links: Link[]) => links.reduce((out: { group?: string; links: Link[] }[], l) => {
  const last = out[out.length - 1];
  if (last && l.group && last.group === l.group) last.links.push(l);
  else out.push({ group: l.group, links: [l] });
  return out;
}, []);
const themes = research.themes.map((t) => ({ ...t, papers: papersFor(t.bibcodes), linkGroups: groupLinks(t.links as Link[]) }));
const other = papersFor(research.other.bibcodes);
const years = (ps: { year: number }[]) => `${Math.min(...ps.map((p) => p.year))}–${Math.max(...ps.map((p) => p.year))}`;

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const titleHtml = (t: string) => escape(t).replace(/&lt;(\/?)(sub|sup|i)&gt;/gi, (_, slash, tag) => `<${slash}${tag.toLowerCase()}>`);
const href = (h: string) => (h.startsWith('/') ? `${root}${h.slice(1)}` : h);
const external = (h: string) => h.startsWith('http');
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width">
      <nav class="theme-index" aria-label="Research themes">
        {themes.map((t, i) => (
          <a class="theme-card" href={`#${t.id}`}>
            <span class="theme-n">{String(i + 1).padStart(2, '0')}</span>
            <strong>{t.title}</strong>
            <span class="theme-meta">{t.papers.length} papers · {years(t.papers)}</span>
          </a>
        ))}
      </nav>

      {themes.map((t, i) => (
        <section class="theme" id={t.id}>
          <div class="theme-head">
            <p class="item-kicker">Theme {i + 1}</p>
            <h2>{t.title}</h2>
            <p>{t.summary}</p>
            {t.links.length > 0 && (
              <div class="item-links">
                {t.linkGroups.map((g) => g.group ? (
                  <div class="link-group">
                    <h3 class="link-group-title">{g.group}</h3>
                    <ul>
                      {g.links.map((l) => (
                        <li><a class="text-link" href={href(l.href)} target={external(l.href) ? '_blank' : undefined} rel={external(l.href) ? 'noopener noreferrer' : undefined}>{l.label} {external(l.href) ? '↗' : '→'}</a></li>
                      ))}
                    </ul>
                  </div>
                ) : g.links.map((l) => (
                  <a class="text-link" href={href(l.href)} target={external(l.href) ? '_blank' : undefined} rel={external(l.href) ? 'noopener noreferrer' : undefined}>{l.label} {external(l.href) ? '↗' : '→'}</a>
                )))}
              </div>
            )}
          </div>
          <ol class="theme-papers">
            {t.papers.map((p) => (
              <li>
                <span class="theme-year">{p.year}</span>
                <span>
                  <a class="pub-title" href={p.url} target="_blank" rel="noopener noreferrer" set:html={titleHtml(p.title)} />
                  <span class="theme-venue">{p.venue}{p.authorPosition === 1 && ' · first author'}</span>
                  {exploreMap.has(p.bibcode) && (
                    <span class="pub-explore">{exploreMap.get(p.bibcode)!.interactive && <><a href={exploreMap.get(p.bibcode)!.interactive}>Interactive page →</a> · </>}<a href={exploreMap.get(p.bibcode)!.notebook} target="_blank" rel="noopener noreferrer">Notebook ↗</a></span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))}

      {other.length > 0 && (
        <section class="theme" id="other">
          <div class="theme-head"><h2>{research.other.title}</h2></div>
          <ol class="theme-papers">
            {other.map((p) => (
              <li>
                <span class="theme-year">{p.year}</span>
                <span>
                  <a class="pub-title" href={p.url} target="_blank" rel="noopener noreferrer" set:html={titleHtml(p.title)} />
                  <span class="theme-venue">{p.venue}</span>
                </span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <p class="back-row"><a href={`${root}publications/`}>All publications, with authors →</a></p>
    </div>
  </section>
</BaseLayout>
