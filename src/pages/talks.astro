---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';

const page = pages.find((p) => p.slug === 'talks')!;
const root = import.meta.env.BASE_URL;
const KINDS: Record<string, string> = {
  conference: 'Conferences and workshops', colloquium: 'Colloquia and seminars', agency: 'Agency and network meetings',
  teaching: 'Teaching', outreach: 'Outreach', testimony: 'Testimony'
};
const talks = (await getCollection('talks')).map((t) => t.data).sort((a, b) => b.date.localeCompare(a.date));
const years = [...new Set(talks.map((t) => t.date.slice(0, 4)))];
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const when = (d: string) => {
  const [y, m, day] = d.split('-').map(Number);
  return day ? `${day} ${MONTHS[m - 1]} ${y}` : `${MONTHS[m - 1]} ${y}`;
};
const today = new Date().toISOString().slice(0, 10);
const counts = Object.fromEntries(Object.keys(KINDS).map((k) => [k, talks.filter((t) => t.kind === k).length]));
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width pub-layout">
      <div class="pub-summary">
        <p><b>{talks.length} talks</b> since {years[years.length - 1]}, most recent first.</p>
        <fieldset class="pub-filter" id="talk-filter">
          <legend>Show</legend>
          {Object.entries(KINDS).filter(([k]) => counts[k] > 0).map(([k, label]) => (
            <label><input type="checkbox" value={k} checked /> {label} ({counts[k]})</label>
          ))}
        </fieldset>
        <p class="pub-source">Talks given by colleagues on work I co-authored are marked with the presenter’s name. Slides are linked where a public copy exists; more will be added. Older talks are being added gradually.</p>
      </div>
      <div>
        {years.map((y) => (
          <section class="pub-year" data-year={y}>
            <h2>{y}</h2>
            {talks.filter((t) => t.date.startsWith(y)).map((t) => (
              <article class="pub-item talk-item" data-kind={t.kind}>
                <p class="talk-date">{when(t.date)}{t.date > today && <span class="talk-upcoming">Upcoming</span>}</p>
                <h3 class="pub-title">{t.title}</h3>
                <p class="pub-venue">{t.event}{t.location && `, ${t.location}`}</p>
                {(t.presenter || t.note) && <p class="talk-note">{t.presenter && `Presented by ${t.presenter}. `}{t.note}</p>}
                {t.materials.length > 0 && (
                  <div class="item-links talk-links">
                    {t.materials.map((m) => <a class="text-link" href={m.url} target="_blank" rel="noopener noreferrer">{m.label} ↗</a>)}
                  </div>
                )}
              </article>
            ))}
          </section>
        ))}
        <p class="back-row"><a href={root}>← Return to homepage</a></p>
      </div>
    </div>
  </section>
  <script>
    const boxes = [...document.querySelectorAll<HTMLInputElement>('#talk-filter input')];
    const update = () => {
      const on = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
      document.querySelectorAll<HTMLElement>('.talk-item').forEach((el) => { el.hidden = !on.has(el.dataset.kind!); });
      document.querySelectorAll<HTMLElement>('.pub-year').forEach((sec) => { sec.hidden = !sec.querySelector('.talk-item:not([hidden])'); });
    };
    boxes.forEach((b) => b.addEventListener('change', update));
  </script>
</BaseLayout>
