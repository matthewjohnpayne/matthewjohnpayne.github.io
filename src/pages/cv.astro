---
import BaseLayout from '../layouts/BaseLayout.astro';
import cv from '../data/cv.json';
import { cvSections, authorList, talkDate } from '../lib/cv';

const root = import.meta.env.BASE_URL;
const { papers, talks, people } = await cvSections();
const pdf = `${root}cv/Matthew_Payne_CV.pdf`;
const join = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(' · ');
---
<BaseLayout title="CV" description={`Curriculum vitae of ${cv.name}, ${cv.position}.`}>
  <section class="inner-hero rf-hero">
    <div class="content-width inner-hero-content cv-hero">
      <p class="eyebrow">CURRICULUM VITAE</p>
      <h1>{cv.name}</h1>
      <p>{cv.position}<br />{cv.institution}</p>
      <div class="cv-actions">
        <a class="button button-primary" href={pdf} download>Download PDF <span aria-hidden="true">↓</span></a>
        <a class="button button-outline" href={`mailto:${cv.email}`}>{cv.email}</a>
      </div>
      <p class="cv-contact">{cv.address} · <a href={`https://orcid.org/${cv.orcid}`} target="_blank" rel="noopener noreferrer">ORCID {cv.orcid}</a> · <a href={cv.github} target="_blank" rel="noopener noreferrer">GitHub</a></p>
    </div>
  </section>

  <section class="site-content page-content">
    <div class="content-width cv-body">
      <section class="cv-section">
        <h2>Profile</h2>
        <div><p class="cv-summary">{cv.summary}</p>
          <ul class="tag-list cv-tags" aria-label="Areas of specialization">{cv.specializations.map((s) => <li>{s}</li>)}</ul></div>
      </section>

      <section class="cv-section">
        <h2>Appointments</h2>
        <div>
          {cv.appointments.map((a) => (
            <div class="cv-row"><p class="cv-dates">{a.dates}</p>
              <div><h3>{a.title}</h3><p class="cv-place">{a.place}</p>{a.details.map((d) => <p class="cv-detail">{d}</p>)}</div></div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>Education</h2>
        <div>
          {cv.education.map((e) => (
            <div class="cv-row"><p class="cv-dates">{e.dates}</p>
              <div><h3>{e.degree}</h3><p class="cv-place">{e.place}</p>{e.details && <p class="cv-detail">{e.details}</p>}</div></div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>Publications</h2>
        <div>
          <p class="cv-summary">{papers.total} refereed papers, {papers.firstAuthor} as first author, from NASA ADS. <a class="text-link" href={`${root}research/?view=year`}>All publications →</a></p>
          <h3 class="cv-subhead">Recent first-author papers</h3>
          <ol class="cv-list">
            {papers.selected.map((p) => (
              <li>{authorList(p.authors, p.authorCount ?? p.authors.length)} ({p.year}). {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}. <i>{p.venue}</i>{p.volume && ` ${p.volume}`}{p.page && `, ${p.page}`}.</li>
            ))}
          </ol>
        </div>
      </section>

      <section class="cv-section">
        <h2>Grants and observing time</h2>
        <div>
          {cv.grants.map((g) => (
            <div class="cv-row"><p class="cv-dates">{g.dates}</p>
              <div><h3>{g.title}</h3><p class="cv-place">{join(g.program, g.role, g.amount)}</p></div></div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>Recent talks</h2>
        <div>
          <ul class="cv-list cv-talks">
            {talks.recent.map((t) => <li><span class="cv-dates-inline">{talkDate(t.date)}</span> {t.title}. <span class="cv-place">{t.event}{t.location && `, ${t.location}`}.</span></li>)}
          </ul>
          <p><a class="text-link" href={`${root}talks/`}>All talks →</a></p>
        </div>
      </section>

      <section class="cv-section">
        <h2>Students and postdocs supervised</h2>
        <div>
          <ul class="cv-list">
            {people.map((p) => <li><b>{p.name}</b>, {join(p.role, p.period)}{p.moreRoles.map((r) => `; ${join(r.role, r.period)}`).join('')}.</li>)}
          </ul>
          <p><a class="text-link" href={`${root}people/`}>People →</a></p>
        </div>
      </section>

      <section class="cv-section">
        <h2>Service</h2>
        <div><ul class="cv-list">{cv.service.map((s) => <li>{s}</li>)}</ul></div>
      </section>

      <section class="cv-section">
        <h2>Computing</h2>
        <div><ul class="tag-list cv-tags">{cv.skills.map((s) => <li>{s}</li>)}</ul>
          <p class="cv-summary"><a class="text-link" href={`${root}software/`}>Software I have written →</a></p></div>
      </section>

      <p class="cv-updated">Last updated {cv.updated}. <a href={pdf} download>Download this CV as a PDF</a>.</p>
    </div>
  </section>
</BaseLayout>
