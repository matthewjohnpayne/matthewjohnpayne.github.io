---
// Teaching is now part of /explore/ ("Explore & learn", merged 2026-10-18). This page sends old
// links there: #nb-<area> (a science-notebook group) becomes that area's group of cards, and any
// other hash is kept. A plain meta refresh (the no-script fallback) drops the hash.
const target = `${import.meta.env.BASE_URL}explore/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Teaching · Matthew Payne</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>location.replace(target + (location.hash.replace(/^#nb-/, '#') || '#teaching'));</script>
    <meta http-equiv="refresh" content={`0; url=${target}#teaching`} />
  </head>
  <body>
    <p>Teaching and tutorials are now on <a href={`${target}#teaching`}>Explore &amp; learn</a>.</p>
  </body>
</html>
