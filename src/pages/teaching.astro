---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';

const page = pages.find((p) => p.slug === 'teaching')!;
const root = import.meta.env.BASE_URL;
const tutorials = (await getCollection('tutorials')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { topic: 'orbits', heading: 'Working with orbits', intro: 'Retrieve MPC orbits, integrate them, and look at the results from different points of view.' },
  { topic: 'animations', heading: 'Orbit animations', intro: 'Animated explanations of how small bodies move near Earth.' }
] as const;
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width">
      {groups.map((group) => (
        <div class="catalogue-group">
          <div class="section-heading"><h2>{group.heading}</h2></div>
          <p class="catalogue-intro">{group.intro}</p>
          <div class="resource-grid">
            {tutorials.filter((t) => t.data.topic === group.topic).map(({ data }) => (
              <article class="resource-item">
                <h3>{data.title}</h3>
                <p>{data.summary}</p>
                {data.tools.length > 0 && <ul class="tag-list" aria-label="Tools used">{data.tools.map((tool) => <li>{tool}</li>)}</ul>}
                <div class="item-links">
                  {data.interactive && <a class="text-link" href={`${root}${data.interactive.replace(/^\//, '')}`}>Interactive version →</a>}
                  <a class="text-link" href={data.url} target="_blank" rel="noopener noreferrer">Open notebook ↗</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
      <div class="editorial-note"><div><span class="status-dot"></span> Source</div><p>These notebooks are published in the <a href="https://docs.minorplanetcenter.net/tutorials/" target="_blank" rel="noopener noreferrer">MPC tutorials</a>, which remain the authoritative versions. Interactive browser adaptations will be linked here as they are built.</p></div>
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>
</BaseLayout>
