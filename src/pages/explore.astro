---
// /explore/: every interactive page, grouped by area. The list comes from src/data/page-status.json
// (see src/lib/interactive.ts), so a new page appears here once it has a status entry.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import ExploreCard from '../components/ExploreCard.astro';
import { explorePages, AREAS } from '../lib/interactive';
const root = import.meta.env.BASE_URL;
const pages = await explorePages();
const groups = Object.entries(AREAS).map(([id, a]) => ({ id, ...a, pages: pages.filter((p) => p.area === id) })).filter((g) => g.pages.length);
---
<BaseLayout title="Explore" description="Interactive essays and simulations: real physics computed in your browser, each based on a paper or notebook.">
  <SectionHero eyebrow="INTERACTIVE ESSAYS & SIMULATIONS" title="Explore" lead={`${pages.length} interactive pages. Each runs real, checked calculations in your browser and is based on a published paper, a notebook or MPC software. Nothing moves until you press play.`} />
  <section class="site-content page-content">
    <div class="content-width">
      <nav class="xp-index" aria-label="Areas">
        {groups.map((g) => <a href={`#${g.id}`}>{g.title} <span>{g.pages.length}</span></a>)}
      </nav>
      {groups.map((g) => (
        <section class="xp-group" id={g.id} aria-labelledby={`${g.id}-h`}>
          <div class="section-heading"><div><h2 id={`${g.id}-h`}>{g.title}</h2>{g.lead && <p class="xp-lead">{g.lead}</p>}</div></div>
          <div class="feature-grid xp-grid">{g.pages.map((p) => <ExploreCard page={p} detail />)}</div>
        </section>
      ))}
      <section class="xp-also" aria-label="Also">
        <p class="section-kicker">ALSO</p>
        <ul>
          <li><a href={`${root}objects/`}>Object of the Month</a>: one small body each month, with its orbit.</li>
          <li><a href={`${root}mpc/#today`}>Today at the Minor Planet Center</a>: the newest circulars and the NEO Confirmation Page, live.</li>
          <li><a href={`${root}teaching/`}>Teaching</a>: the notebooks behind these pages, and the MPC tutorials.</li>
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
<style>
  .xp-index { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; }
  .xp-index a { padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font-size: 13px; color: var(--ink); }
  .xp-index a:hover, .xp-index a:focus-visible { border-color: var(--teal); }
  .xp-index span { color: var(--teal); font-weight: 650; margin-left: 4px; }
  .xp-group { margin-bottom: 48px; scroll-margin-top: 20px; }
  .xp-lead { margin: 6px 0 0; color: var(--body); font-size: 14px; }
  .xp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .xp-also { border-top: 1px solid var(--line); padding-top: 24px; }
  .xp-also ul { margin: 0; padding-left: 18px; color: var(--body); font-size: 14px; line-height: 1.8; }
  @media (max-width: 1080px) { .xp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 575px) { .xp-grid { grid-template-columns: 1fr; } }
</style>
