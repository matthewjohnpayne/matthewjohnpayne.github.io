---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';
import site from '../data/site.json';

const page = pages.find((p) => p.slug === 'software')!;
const root = import.meta.env.BASE_URL;
const software = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order);
const sections = [
  { heading: 'Selected projects', items: software.filter((s) => s.data.featured) },
  { heading: 'More repositories', items: software.filter((s) => !s.data.featured) }
];
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width">
      {sections.filter((s) => s.items.length > 0).map((section) => (
        <div class="catalogue-group">
          <div class="section-heading"><h2>{section.heading}</h2></div>
          <div class="resource-grid">
            {section.items.map(({ data }) => (
              <article class="resource-item">
                <h3 class="code-name">{data.name}</h3>
                <p>{data.summary}</p>
                {data.language && <ul class="tag-list" aria-label="Language"><li>{data.language}</li></ul>}
                <div class="item-links"><a class="text-link" href={data.repo} target="_blank" rel="noopener noreferrer">View on GitHub ↗</a></div>
              </article>
            ))}
          </div>
        </div>
      ))}
      <div class="editorial-note"><div><span class="status-dot"></span> More on GitHub</div><p>Descriptions are taken from each repository. See <a href={site.github} target="_blank" rel="noopener noreferrer">my GitHub profile</a> for every public repository.</p></div>
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>
</BaseLayout>
