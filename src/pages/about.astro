---
// About Matthew Payne. Drafted 2026-10-17 from the MPC staff page (minorplanetcenter.net/about),
// src/data/cv.json and facts Matthew supplied in conversation (Acting Director from February 2021,
// Director from 2022; hired as project scientist in April 2017; the (20592) Payne certificate at
// ACM 2026). Not linked from the navigation, and noindex, until Matthew approves it.
// Sections only Matthew can write appear as placeholders under `npm run dev` and are left out of
// the built site until he supplies the text.
// The orbit figure is drawn at build time from the MPC orbit in src/data/asteroid-20592.json
// (tools/export_about_asteroid.py): an exact Keplerian ellipse projected onto the ecliptic.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import cv from '../data/cv.json';
import site from '../data/site.json';
import orbit from '../data/asteroid-20592.json';

const root = import.meta.env.BASE_URL;
const dev = import.meta.env.DEV;
const ext = { target: '_blank', rel: 'noopener noreferrer' };

// Sections Matthew writes. Each stays out of the built site until it has text.
const fromMatthew: [string, string][] = [
  ['Outside work', '']   // optional: a line or two in his own words (how he came to astronomy, interests)
];

// ---- Orbit of (20592) Payne, seen from above the ecliptic ----
const { a, e, i, node, argperi, mean_anomaly } = orbit.kep;
const rad = Math.PI / 180;
const W = 360, H = 360, cx = W / 2, cy = H / 2, scale = 160 / 5.6;   // Jupiter's orbit fits the frame
const toXY = (f: number) => {
  const r = (a * (1 - e * e)) / (1 + e * Math.cos(f));
  const u = argperi * rad + f, O = node * rad, inc = i * rad;
  const x = r * (Math.cos(O) * Math.cos(u) - Math.sin(O) * Math.sin(u) * Math.cos(inc));
  const y = r * (Math.sin(O) * Math.cos(u) + Math.cos(O) * Math.sin(u) * Math.cos(inc));
  return [cx + scale * x, cy - scale * y];   // ecliptic x to the right (vernal equinox), y up
};
const ellipse = Array.from({ length: 361 }, (_, k) => toXY((2 * Math.PI * k) / 360))
  .map(([x, y], k) => `${k ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ') + ' Z';
// Position at the orbit's epoch: solve Kepler's equation, then the true anomaly.
const M = mean_anomaly * rad;
let E = M;
for (let k = 0; k < 30; k++) E -= (E - e * Math.sin(E) - M) / (1 - e * Math.cos(E));
const f0 = 2 * Math.atan2(Math.sqrt(1 + e) * Math.sin(E / 2), Math.sqrt(1 - e) * Math.cos(E / 2));
const [px, py] = toXY(f0);
// Planet labels: Earth below its circle, the others above, so the inner two do not collide.
const planets: [string, number, number][] = [['Earth', 1.0, 1], ['Mars', 1.524, -1], ['Jupiter', 5.203, -1]];
// The asteroid's label sits outside its orbit, on the side away from the Sun.
const out = Math.hypot(px - cx, py - cy);
const lx = px + (14 * (px - cx)) / out, ly = py + (14 * (py - cy)) / out + 4;
const anchor = px < cx - 20 ? 'end' : px > cx + 20 ? 'start' : 'middle';
const epochDate = new Date((orbit.epochMJD_TT - 40587) * 86400000)
  .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const periodYears = (orbit.periodDays / 365.25).toFixed(1);
const mpcLink = 'https://minorplanetcenter.net/db_search/show_object?object_id=20592';
const jplLink = 'https://ssd.jpl.nasa.gov/tools/sbdb_lookup.html#/?sstr=20592';
---
<BaseLayout title="About" description="About Matthew Payne, Director of the Minor Planet Center." noindex>
  <SectionHero eyebrow="ABOUT" title="About me" lead="I direct the Minor Planet Center, where the world’s observations of asteroids, comets and other small bodies of the Solar System come together and become orbits." />
  <section class="site-content rf-prose">
    <div class="content-width rf-prose-inner">
      {dev && <p class="about-draft">Draft for Matthew’s review. This page is not linked from the navigation and is hidden from search engines until he approves it.</p>}

      <p>The Minor Planet Center (MPC) is the single worldwide location for receiving and distributing positional measurements of asteroids, comets and the outer irregular moons of the planets. Professional surveys and amateur astronomers around the world send us their measurements. We link them to known objects, identify new discoveries, give them designations, compute their orbits and publish the results, which are the starting point for everything from impact monitoring to studies of how the Solar System formed. The MPC is part of the Smithsonian Astrophysical Observatory, at the Center for Astrophysics | Harvard &amp; Smithsonian, and works under the auspices of the International Astronomical Union.</p>

      <h2>How I got here</h2>
      <p>I studied physics at the University of Oxford (MPhys, 2001). After an ill-considered spell as a management consultant in London, I returned to academia at the University of Cambridge, first for Part III of the Mathematical Tripos (2005) and then a PhD in astronomy at the Institute of Astronomy (2009), on the formation and evolution of planetary systems.</p>
      <p>I then held postdoctoral positions at the University of Florida and at the Harvard-Smithsonian Center for Astrophysics, followed by a research scientist position at the Smithsonian Astrophysical Observatory. I joined the MPC as its project scientist in April 2017, leading the design of new software for processing and cataloguing observations. I became Acting Director in February 2021, and Director in 2022.</p>

      <h2>What I work on</h2>
      <p>My research is on the dynamics of Solar System bodies and exoplanets, and on processing the large data sets produced by surveys such as TESS, Pan-STARRS and the Rubin Observatory’s Legacy Survey of Space and Time. The <a href={`${root}research/`}>Research</a> page describes the main themes, with the papers behind each, and <a href={`${root}explore/`}>Explore</a> has interactive versions of several of them that run in your browser.</p>

      <h2>Roles beyond the MPC</h2>
      <ul>
        <li>Member of the Steering Committee of the <a href="https://iawn.net/" {...ext}>International Asteroid Warning Network</a> (IAWN), for data management, archiving and distribution.</li>
        <li>Testified on planetary defence to the U.S. House Committee on Science, Space, and Technology’s Subcommittee on Space and Aeronautics in May 2025 (“From Detection to Deflection”; see <a href={`${root}talks/`}>Talks</a>).</li>
        <li>Reviewer for NASA and NSF panels, and referee for the main astronomy journals.</li>
      </ul>

      <h2>An asteroid of my own</h2>
      <figure class="about-orbit">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="about-orbit-cap">
          {planets.map(([name, r, side]) => (
            <g>
              <circle cx={cx} cy={cy} r={scale * r} fill="none" stroke="#c9d8dc" stroke-width="1" />
              <text x={cx} y={side > 0 ? cy + scale * r + 13 : cy - scale * r - 5} text-anchor="middle" class="about-orbit-label">{name}</text>
            </g>
          ))}
          <path d={ellipse} fill="none" stroke="#078d97" stroke-width="2" />
          <circle cx={cx} cy={cy} r="5" fill="#e9a160" />
          <circle cx={px} cy={py} r="4.5" fill="#078d97" stroke="#fff" stroke-width="1.5" />
          <text x={lx} y={ly} text-anchor={anchor} class="about-orbit-label about-orbit-name">(20592) Payne</text>
        </svg>
        <figcaption id="about-orbit-cap">The orbit of (20592) Payne seen from above the plane of the Solar System, drawn from the MPC’s orbit (epoch {epochDate}), with its position at that date. The planets’ orbits are shown as circles at their average distances from the Sun.</figcaption>
      </figure>
      <p>Asteroid <a href={mpcLink} {...ext}>(20592) Payne</a>, provisionally designated {orbit.provisional}, was discovered by the LINEAR survey at Socorro, New Mexico, on 9 September 1999. It is named after me in the Working Group for Small Bodies Nomenclature’s <i>WGSBN Bulletin</i> 6, no. 11, and the naming certificate was presented at the Asteroids, Comets, Meteors conference in 2026. It is a main-belt asteroid about {orbit.kep.a.toFixed(2)} times as far from the Sun as Earth, going round once every {periodYears} years. Its orbit is known from {orbit.nobs.toLocaleString('en-GB')} observations made between {orbit.arc.replace('-', ' and ')} (details at the <a href={jplLink} {...ext}>JPL Small-Body Database</a>).</p>

      {fromMatthew.map(([heading, text]) => (text ? (
        <><h2>{heading}</h2><p>{text}</p></>
      ) : dev && (
        <div class="about-placeholder"><h2>{heading}</h2><p>Optional, to be written by Matthew. This section is left out of the published page until then.</p></div>
      )))}

      <h2>Contact and links</h2>
      <p>Email: <span class="about-email">{cv.email}</span>. Questions about MPC data, observation submissions or specific objects are best sent to the MPC through its <a href="https://docs.minorplanetcenter.net/" {...ext}>documentation and help pages</a>, where the right person will see them.</p>
      <ul>
        <li><a href={`${root}cv/`}>CV</a> (with a PDF version)</li>
        <li><a href={`https://orcid.org/${cv.orcid}`} {...ext}>ORCID {cv.orcid}</a></li>
        <li><a href={cv.github} {...ext}>GitHub</a> · <a href={site.cfaProfile} {...ext}>Center for Astrophysics profile</a></li>
      </ul>
      <p class="about-note">The views on this site are my own, not those of the Minor Planet Center, the Smithsonian Institution or the International Astronomical Union.</p>
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-draft { border-left: 4px solid #e9a160; background: #fdf6ee; padding: 10px 16px; font-size: 14px !important; }
  .about-placeholder { border: 2px dashed #e9a160; border-radius: 6px; padding: 4px 18px 16px; margin: 30px 0; background: #fdf6ee; }
  .about-placeholder h2 { margin-top: 16px; }
  .about-orbit { margin: 8px 0 22px; max-width: 420px; }
  .about-orbit svg { width: 100%; height: auto; display: block; }
  .about-orbit-label { font-size: 11px; fill: #607683; font-family: inherit; }
  .about-orbit-name { fill: #1b3040; font-weight: 600; }
  .about-orbit figcaption { font-size: 13px; line-height: 1.6; color: var(--body); margin-top: 6px; }
  .about-note { font-size: 14px !important; font-style: italic; }
  .about-email { user-select: all; }
</style>
