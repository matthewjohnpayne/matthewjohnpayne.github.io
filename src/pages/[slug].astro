---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/pages.json';
import site from '../data/site.json';

export function getStaticPaths() {
  return pages.map((page) => ({params:{slug:page.slug}, props:{page}}));
}
const {page} = Astro.props;
const root = import.meta.env.BASE_URL;
const link = (path: string) => path.startsWith('http') ? path : `${root}${path.replace(/^\//, '')}`;
---
<BaseLayout title={page.title} description={page.summary}>
  <section class="inner-hero">
    <div class="content-width inner-hero-content">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p>{page.lead}</p>
    </div>
  </section>
  <section class="site-content page-content">
    <div class="content-width">
      <div class="section-heading"><h2>Explore {page.title.toLowerCase()}</h2></div>
      <div class="resource-grid">
        {page.items.map((item) => <article class="resource-item"><h3>{item.title}</h3><p>{item.text}</p>{item.link && <a class="text-link" href={link(item.link)} target={item.link.startsWith('http') ? '_blank' : undefined} rel={item.link.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.cta || 'Explore'} ↗</a>}</article>)}
      </div>
      <div class="editorial-note"><div><span class="status-dot"></span> Version 0.1</div><p>This section is a curated starting point. Research projects, collaborators, publications and notebooks will be added as verified content rather than autogenerated entries.</p></div>
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>
</BaseLayout>
