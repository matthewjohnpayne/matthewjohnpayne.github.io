---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';
import collab from '../data/collaborators.json';
import staff from '../data/mpc-staff.json';
import meta from '../data/publications-meta.json';

const page = pages.find((p) => p.slug === 'people')!;
const root = import.meta.env.BASE_URL;
const mentees = (await getCollection('people'))
  .filter((p) => p.data.relationship === 'mentee')
  .map((p) => p.data)
  .sort((a, b) => b.order - a.order || a.name.localeCompare(b.name));

// ADS gives "Holman, Matthew J."; show "Matthew J. Holman".
const display = (name: string) => {
  const [last, first] = name.split(/,\s*/);
  return first ? `${first} ${last}` : name;
};
const people = collab.collaborators;
const span = (c: { first: number; last: number }) => (c.first === c.last ? `${c.first}` : `${c.first}–${c.last}`);
const join = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(' · ');
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width">
      <nav class="people-jump" aria-label="On this page">
        <a href="#students">Students and postdocs</a>
        <a href="#mpc">Minor Planet Center staff</a>
        <a href="#collaborators">Collaborators</a>
      </nav>

      <div class="catalogue-group" id="students">
        <div class="section-heading"><h2>Students and postdocs</h2></div>
        <p class="catalogue-intro">Students and postdoctoral researchers I have supervised or advised. Interested in joining them? See <a href={`${root}work-with-me/`}>Working with me</a>.</p>
        <ul class="people-list people-list-wide">
          {mentees.map((m) => {
            const lines = [{ role: m.role, roleUrl: m.roleUrl, period: m.period }, ...m.moreRoles];
            const meta = <span class="people-meta">{lines.map((l) => <span class="people-meta-line">{l.roleUrl && !m.url
              ? <a class="people-role-link" href={l.roleUrl} target="_blank" rel="noopener noreferrer">{l.role}</a>
              : l.role}{l.role && l.period && ' · '}{l.period && <span class="people-period">{l.period}</span>}</span>)}</span>;
            const who = <span class="people-who"><span class="people-name">{m.name}{m.url && <span class="people-ext" aria-hidden="true"> ↗</span>}</span>{m.now && <span class="people-now">Now: {m.now}</span>}</span>;
            return <li>
              {m.url
                ? <a href={m.url} target="_blank" rel="noopener noreferrer">{who}{meta}</a>
                : <div class="people-row">{who}{meta}</div>}
            </li>;
          })}
        </ul>
      </div>

      <div class="catalogue-group" id="mpc">
        <div class="section-heading"><h2>Minor Planet Center staff</h2></div>
        <p class="catalogue-intro">The team I work with at the <a href={staff.source} target="_blank" rel="noopener noreferrer">Minor Planet Center ↗</a>, where I am Director, and former colleagues I worked with there.</p>
        <h3 class="people-subhead">Current</h3>
        <ul class="people-list">
          {staff.current.map((s) => (
            <li><div class="people-row"><span class="people-name">{s.name}</span><span class="people-meta">{join(s.role, s.since && `since ${s.since}`)}</span></div></li>
          ))}
        </ul>
        <h3 class="people-subhead">Former</h3>
        <ul class="people-list">
          {staff.former.map((s) => (
            <li><div class="people-row"><span class="people-name">{s.name}</span><span class="people-meta">{s.role}</span></div></li>
          ))}
        </ul>
      </div>

      <div class="catalogue-group" id="collaborators">
        <div class="section-heading"><h2>Collaborators</h2></div>
        <p class="catalogue-intro">The {people.length} colleagues I have co-authored two or more refereed papers with, most shared papers first. Large collaboration papers (over 40 authors) are not counted. Select a name to see our papers together.</p>
        <ul class="people-list">
          {people.map((c) => (
            <li>
              <a href={`${root}research/?view=year#with=${encodeURIComponent(c.key)}`}>
                <span class="people-name">{display(c.name)}</span>
                <span class="people-meta">{c.papers} papers · {span(c)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="editorial-note"><div><span class="status-dot"></span> Sources</div><p>Collaborators are generated from the same NASA ADS search as the <a href={`${root}research/?view=year`}>publication list</a>, last updated {meta.fetched}. MPC staff follow the MPC's own staff page and its archived versions.</p></div>
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>
</BaseLayout>
