---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import pages from '../data/pages.json';
import collab from '../data/collaborators.json';
import meta from '../data/publications-meta.json';

const page = pages.find((p) => p.slug === 'people')!;
const root = import.meta.env.BASE_URL;
const mentees = (await getCollection('people')).filter((p) => p.data.relationship === 'mentee').map((p) => p.data);

// ADS gives "Holman, Matthew J."; show "Matthew J. Holman".
const display = (name: string) => {
  const [last, first] = name.split(/,\s*/);
  return first ? `${first} ${last}` : name;
};
const people = collab.collaborators;
const span = (c: { first: number; last: number }) => (c.first === c.last ? `${c.first}` : `${c.first}–${c.last}`);
---
<BaseLayout title={page.title} description={page.summary}>
  <SectionHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} />
  <section class="site-content page-content">
    <div class="content-width">
      {mentees.length > 0 && (
        <div class="catalogue-group">
          <div class="section-heading"><h2>Mentorship</h2></div>
          <div class="resource-grid">
            {mentees.map((m) => (
              <article class="resource-item">
                <h3>{m.name}</h3>
                {(m.role || m.period) && <p class="item-kicker">{[m.role, m.period].filter(Boolean).join(' · ')}</p>}
                {m.summary && <p>{m.summary}</p>}
                {m.url && <div class="item-links"><a class="text-link" href={m.url} target="_blank" rel="noopener noreferrer">Profile ↗</a></div>}
              </article>
            ))}
          </div>
        </div>
      )}

      <div class="catalogue-group">
        <div class="section-heading"><h2>Collaborators</h2></div>
        <p class="catalogue-intro">The {people.length} colleagues I have co-authored two or more refereed papers with, most shared papers first. Large collaboration papers (over 40 authors) are not counted. Select a name to see our papers together.</p>
        <ul class="people-list">
          {people.map((c) => (
            <li>
              <a href={`${root}publications/#with=${encodeURIComponent(c.key)}`}>
                <span class="people-name">{display(c.name)}</span>
                <span class="people-meta">{c.papers} papers · {span(c)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="editorial-note"><div><span class="status-dot"></span> From NASA ADS</div><p>Generated from the same ADS search as the <a href={`${root}publications/`}>publication list</a>, last updated {meta.fetched}.</p></div>
      <p class="back-row"><a href={root}>← Return to homepage</a></p>
    </div>
  </section>
</BaseLayout>
