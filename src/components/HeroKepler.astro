---
// The homepage hero figure (inside HomeOrbit.astro): one perihelion, every kind of orbit. Conics with
// a common perihelion distance and focus, for e = 0 (circle), 0.2-0.9 (ellipses), 1 (parabola, solid
// orange) and 1.4, 2.5 (hyperbolas, dashed), drawn exactly from r = q(1 + e) / (1 + e cos f), in the
// style of the "Research at a glance" cards. Chosen by Matthew on 2026-10-17 from three candidates.
const W = 400, H = 260;
const TEAL = '#128f9c', GRID = '#d8e4e7', ORANGE = '#ec9d58';
const f1 = (v: number) => v.toFixed(1);
const path = (pts: { x: number; y: number }[], close = false) =>
  'M' + pts.map((p) => `${f1(p.x)},${f1(p.y)}`).join(' L') + (close ? ' Z' : '');

// Position at true anomaly f (radians) on a conic of perihelion distance q and eccentricity e,
// focus at (sx, sy), perihelion to the left, y up the page.
const conicPoint = (sx: number, sy: number, q: number, e: number, f: number) => {
  const r = (q * (1 + e)) / (1 + e * Math.cos(f));
  return { x: sx - r * Math.cos(f), y: sy - r * Math.sin(f) };
};

const sx = 120, sy = H / 2, q = 38;
const bound = [0, 0.2, 0.4, 0.55, 0.7, 0.8, 0.9];
const unbound = [1, 1.4, 2.5];
const parts: string[] = [];
bound.forEach((e, i) => {
  const pts = Array.from({ length: 721 }, (_, k) => conicPoint(sx, sy, q, e, (2 * Math.PI * k) / 720));
  parts.push(`<path d="${path(pts, true)}" stroke="${TEAL}" stroke-width="${e === 0 ? 1.6 : 1.3}" stroke-opacity="${(1 - 0.09 * i).toFixed(2)}" fill="none"/>`);
});
unbound.forEach((e, i) => {
  const fmax = e === 1 ? 2.9 : Math.acos(-1 / e) - 0.02;
  const pts = Array.from({ length: 401 }, (_, k) => conicPoint(sx, sy, q, e, -fmax + (2 * fmax * k) / 400));
  parts.push(`<path d="${path(pts)}" stroke="${ORANGE}" stroke-width="1.3" stroke-opacity="${(0.95 - 0.2 * i).toFixed(2)}" fill="none"${e === 1 ? '' : ' stroke-dasharray="5 3"'}/>`);
});
const svg = `<defs><clipPath id="hk-clip"><rect x="0" y="0" width="${W}" height="${H}"/></clipPath></defs>
  <line x1="0" y1="${sy}" x2="${W}" y2="${sy}" stroke="${GRID}" stroke-width="1"/>
  <g clip-path="url(#hk-clip)">${parts.join('')}</g>
  <circle cx="${sx}" cy="${sy}" r="7" fill="${ORANGE}"/>
  <circle cx="${sx - q}" cy="${sy}" r="3.5" fill="${TEAL}"/>`;
---
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" class="science-art" aria-hidden="true" set:html={svg} />
