---
// "Today at the MPC": newest circulars and the NEO Confirmation Page count, refreshed in the browser.
import { mpcToday } from '../lib/mpcToday';
import { fmtDate, fmtTime, RECENT_MPECS, NEOCP, MPC } from '../scripts/mpctoday/parse.js';
const today = await mpcToday();
const built = fmtTime(today.fetched);
const status = today.fromSnapshot
  ? `Saved copy from ${built}; your browser is asking the MPC for the latest.`
  : `As of ${built}, when this site was built; your browser is asking the MPC for the latest.`;
const offline = `The MPC could not be reached just now, so these are the figures from ${built}.`;
---
<section class="mpc-today" id="today" aria-labelledby="mpc-today-h" data-mpc-today data-offline-text={offline}>
  <div class="section-heading">
    <div><p class="section-kicker">LIVE FROM THE MPC</p><h2 id="mpc-today-h">Today at the Minor Planet Center</h2></div>
  </div>
  <div class="mpc-today-grid">
    <div class="mpc-today-card">
      <h3>Latest circulars</h3>
      <p class="mpc-today-gloss">
        <a href={`${MPC}/iau/services/MPEC.html`} target="_blank" rel="noopener noreferrer">Minor Planet Electronic Circulars</a> (MPECs)
        announce new discoveries of near-Earth and trans-Neptunian objects, with their orbits, and carry routine material on comets.
        A Daily Orbit Update circular lists the new identifications and orbits of the previous 24 hours.
      </p>
      <ul class="mpc-today-list" data-mpec-list>
        {today.mpecs.map((m) => <li>
          <a href={m.url} target="_blank" rel="noopener noreferrer">MPEC {m.id}</a>
          <span class="mpc-today-subject">{m.subject}</span>
          <time datetime={m.date}>{fmtDate(m.date + 'T00:00:00Z')}</time>
        </li>)}
      </ul>
      <a class="text-link" href={RECENT_MPECS} target="_blank" rel="noopener noreferrer">All recent MPECs <span aria-hidden="true">↗</span></a>
    </div>
    <div class="mpc-today-card">
      <h3>Awaiting confirmation</h3>
      <p class="mpc-today-count"><span data-neocp-count>{today.neocp.count.toLocaleString('en-US')}</span> <span class="mpc-today-unit">objects on the NEO Confirmation Page</span></p>
      <p class="mpc-today-gloss">
        Newly found moving objects that might be near-Earth objects are listed on the{' '}
        <a href={NEOCP} target="_blank" rel="noopener noreferrer">NEO Confirmation Page</a> so that other observatories can follow them up.
        Their extra observations pin down each orbit and show which objects really come close to Earth.
      </p>
      <p class="mpc-today-meta">Page last updated by the MPC on <span data-neocp-updated>{fmtTime(today.neocp.updated)}</span>.</p>
    </div>
  </div>
  <p class="mpc-today-source" aria-live="polite" data-today-status>{status}</p>
</section>
<script>
  import { refreshMpcToday } from '../scripts/mpctoday/refresh.js';
  refreshMpcToday();
</script>
<style>
  .mpc-today { margin-top: 66px; scroll-margin-top: 90px; }
  .mpc-today-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 18px; }
  .mpc-today-card { background: #fff; border: 1px solid var(--line); border-radius: 7px; padding: 22px 24px; display: flex; flex-direction: column; gap: 10px; }
  .mpc-today-card h3 { margin: 0; font-size: 16px; }
  .mpc-today-gloss { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.55; }
  .mpc-today-gloss a, .mpc-today-source a { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .mpc-today-list { list-style: none; margin: 4px 0; padding: 0; border-top: 1px solid var(--line); }
  .mpc-today-list :global(li) { display: grid; grid-template-columns: 9.5em minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .mpc-today-list :global(a) { color: var(--teal); font-weight: 600; font-variant-numeric: tabular-nums; }
  .mpc-today-list :global(.mpc-today-subject) { color: var(--ink); overflow-wrap: anywhere; }
  .mpc-today-list :global(time) { color: var(--muted); font-size: 13px; white-space: nowrap; }
  .mpc-today-count { margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .mpc-today-count [data-neocp-count] { font-size: clamp(30px, 3vw, 40px); font-weight: 640; letter-spacing: -.03em; color: var(--teal); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .mpc-today-unit { font-size: 14px; font-weight: 640; color: var(--ink); }
  .mpc-today-meta, .mpc-today-source { font-size: 12px; color: var(--muted); margin: 0; }
  .mpc-today-source { margin-top: 12px; }
  @media (max-width: 820px) { .mpc-today-grid { grid-template-columns: 1fr; } }
  @media (max-width: 575px) {
    .mpc-today { margin-top: 40px; }
    .mpc-today-card { padding: 16px 18px; }
    .mpc-today-list :global(li) { grid-template-columns: minmax(0, 1fr) auto; }
    .mpc-today-list :global(.mpc-today-subject) { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
