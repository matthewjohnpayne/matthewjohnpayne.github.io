---
// One interactive page as a card, for /explore/ and the homepage strip (src/lib/interactive.ts).
import ExploreThumb from './ExploreThumb.astro';
import type { ExplorePage } from '../lib/interactive';
interface Props { page: ExplorePage; detail?: boolean }
const { page, detail = false } = Astro.props;
const root = import.meta.env.BASE_URL;
const paper = page.basedOn.find((s) => s.bibcode) ?? page.basedOn[0];
---
<a class="feature-card xc" href={`${root}${page.path}/`}>
  <div class="feature-illustration"><ExploreThumb visual={page.visual} area={page.area} label={paper?.label ?? ''} /></div>
  <div class="feature-copy">
    <h3>{page.title}</h3>
    <p>{page.teaser}</p>
    {detail && paper && <p class="xc-meta">Based on {paper.label}</p>}
    <span class="small-link">Open <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .xc { display: flex; flex-direction: column; color: inherit; }
  .xc .feature-copy { flex: 1; display: flex; flex-direction: column; }
  .xc .feature-copy p { min-height: 0; margin-bottom: 12px; }
  .xc .small-link { margin-top: auto; }
  .xc .xc-meta { font-size: 12px; color: var(--muted); margin: -4px 0 14px; }
  .xc .feature-illustration { padding: 0; }
  .xc .feature-illustration :global(.science-art) { padding: 7px 12px; }
</style>
